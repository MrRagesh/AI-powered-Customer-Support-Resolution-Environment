# Copy to .env and fill in real values

APP_NAME=AI Customer Support OpenEnv
APP_VERSION=1.0.0
DEBUG=false

# REQUIRED — minimum 16 chars
API_KEY=changeme-dev-key-only-32chars!!

# LLM — set OPENAI_API_KEY for full capability; leave blank to use fallbacks
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite+aiosqlite:///./support_env.db

# Redis (optional)
REDIS_URL=

# FAISS
FAISS_INDEX_PATH=./faiss_index
FAISS_TOP_K=5

# Reward shaping
REWARD_RESOLUTION=1.0
REWARD_PARTIAL=0.3
REWARD_ESCALATION=0.1
REWARD_FAILURE=-0.5
REWARD_STEP_PENALTY=-0.05

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
